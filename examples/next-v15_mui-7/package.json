{
  "name": "next-v15-mui-7",
  "version": "1.0.0",
  "description": "Next.js v15 app with MUI v7, Mui Pickers v8 to test @nish1896/rhf-mui-components",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "prod": "pnpm build && pnpm start",
    "lint": "next lint --fix",
    "lint:check": "next lint",
    "check-updates": "ncu --format group -u",
    "install-updates": "pnpm check-updates && pnpm install"
  },
  "dependencies": {
    "@ckeditor/ckeditor5-react": "^9.0.0",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@faker-js/faker": "^9.7.0",
    "@hookform/resolvers": "^5.0.1",
    "@mui/icons-material": "^7.0.2",
    "@mui/material": "^7.0.2",
    "@mui/material-nextjs": "^7.0.2",
    "@mui/x-date-pickers": "^8.1.0",
    "@nish1896/rhf-mui-components": "latest",
    "ckeditor5": "^43.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.13",
    "joi": "^17.13.3",
    "luxon": "^3.6.1",
    "moment": "^2.30.1",
    "next": "15.3.1",
    "react": "^19.1.0",
    "react-color-palette": "7.3.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.56.1",
    "react-international-phone": "^4.5.0",
    "react-json-view": "^1.21.3",
    "react-toastify": "^11.0.5",
    "superstruct": "^2.0.2",
    "yup": "^1.6.1",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@nish1896/eslint-flat-config": "^2.0.4",
    "@tailwindcss/postcss": "^4.1.4",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.0.4",
    "eslint": "^9.25.1",
    "eslint-config-next": "15.3.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.1",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.8.3"
  },
  "lint-staged": {
    "*.{json,html,css,sass,scss}": [
      "prettier --write --ignore-unknown"
    ],
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ]
  },
  "packageManager": "pnpm@10.10.0",
  "keywords": [
    "nextjs",
    "template",
    "material-ui",
    "tailwindcss",
    "docker"
  ],
  "license": "MIT"
}
