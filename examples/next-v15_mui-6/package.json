    "@hookform/resolvers": "^3.9.0",
    "@mui/icons-material": "^6.4.11",
    "@mui/material": "^6.4.11",
    "@mui/material-nextjs": "^6.4.3",
    "@mui/x-date-pickers": "^7.29.1",
    "@nish1896/rhf-mui-components": "latest",
    "ckeditor5": "^43.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
